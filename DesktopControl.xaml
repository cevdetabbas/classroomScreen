<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="180" Height="190" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" Opacity="0.5" UseLayoutRounding="True" Title="Classroom Display">
 <Grid Background="{x:Null}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
   <Button x:Name="Power" Width="132" Height="132" Cursor="Hand" AutomationProperties.Name="Toggle classroom display" Background="Transparent">
    <Button.Template><ControlTemplate TargetType="Button">
     <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5"><ContentPresenter/></Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Button.Template>
    <Grid Width="132" Height="132">
     <Ellipse x:Name="Halo" Margin="12" Stroke="#55F7A0" StrokeThickness="7" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="13"/></Ellipse.Effect></Ellipse>
     <Ellipse Margin="14" StrokeThickness="1" Stroke="#667C8A94">
      <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
       <GradientStop Color="#EF303B45" Offset="0"/><GradientStop Color="#F41A222B" Offset="0.5"/><GradientStop Color="#F010161D" Offset="1"/>
      </LinearGradientBrush></Ellipse.Fill>
      <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.3"/></Ellipse.Effect>
     </Ellipse>
     <Ellipse x:Name="Ring" Margin="21" StrokeThickness="1.5" Stroke="#55F7A0"/>
     <Ellipse Margin="25" StrokeThickness="0.5" Stroke="#167FBA99"/>
     <Path x:Name="PowerIcon" Data="M 66,46 L 66,63 M 52,52 A 21,21 0 1 0 80,52" Stroke="#8FFFC0" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    </Grid>
   </Button>
   <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#F5F8FA">
    <Run Text="CLASSROOM"/><LineBreak/><Run Text="DISPLAY"/>
    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.85"/></TextBlock.Effect>
   </TextBlock>
  </StackPanel>
  <Button x:Name="Settings" Width="30" Height="30" Margin="0,22,18,0"
   HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" ToolTip="Display settings"
   AutomationProperties.Name="Display settings" Foreground="#E3F1EB" Background="#222F36" BorderBrush="#78938B">
   <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="19"/>
  </Button>
 </Grid>
</Window>
